
# - Para un servidor remoto, definí DB_SERVER (ej. 192.168.1.10).
#DB_SERVER=172.21.80.1
DB_PORT=1433
DB_NAME=DB_StockCare

# Autenticación SQL Server (obligatoria).
# La conexión no usa el login de Windows: solo usuario y contraseña SQL.
DB_USER=usuario_stockcare
DB_PASSWORD=TuClaveSegura

DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
