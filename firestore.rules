rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - uid: string (required, immutable)
//   - email: string (required)
//   - fullName: string (required)
//   - role: string (required, 'ADMIN' | 'BODEGA')
//   - branch: string (optional)
//   - createdAt: string / timestamp
//
// Collection: products
// Document ID: {productId}
// Fields:
//   - code: string (required, unique identifier)
//   - name: string (required)
//   - category: string (required)
//   - presentation: string (required)
//   - minStock: number (required, >= 0)
//   - status: string (required, 'Activo' | 'Inactivo')
//   - description: string (optional)
//   - createdAt: string
//   - updatedAt: string
//
// Collection: batches
// Document ID: {batchId}
// Fields:
//   - productId: string (required)
//   - batchNumber: string (required)
//   - quantity: number (required, >= 0)
//   - initialQuantity: number (required, >= 0)
//   - expiryDate: string (required, YYYY-MM-DD)
//   - entryId: string (required)
//   - createdAt: string
//
// Collection: entries
// Document ID: {entryId}
// Fields:
//   - documentNumber: string (required)
//   - provider: string (required)
//   - date: string (required, YYYY-MM-DD)
//   - registeredBy: string (required)
//   - createdAt: string
//   - items: list (required)
//   - notes: string (optional)
//
// Collection: exits
// Document ID: {exitId}
// Fields:
//   - productId: string (required)
//   - batchId: string (required)
//   - batchNumber: string (required)
//   - quantity: number (required, > 0)
//   - reason: string (required)
//   - reference: string (required)
//   - date: string (required, YYYY-MM-DD)
//   - registeredBy: string (required)
//   - createdAt: string
//   - notes: string (optional)
//
// Collection: movements
// Document ID: {movementId}
// Fields:
//   - date: string (required, YYYY-MM-DD)
//   - createdAt: string (required)
//   - productId: string (required)
//   - batchNumber: string (required)
//   - type: string (required, 'Entrada' | 'Salida')
//   - quantity: number (required, > 0)
//   - user: string (required)
//   - reference: string (required)
//   - detail: string (required)
//   - resultingStock: number (required, >= 0)
//
// Collection: settings
// Document ID: system
// Fields:
//   - pharmacyName: string
//   - branchName: string
//   - branchAddress: string
//   - phone: string
//   - expiryAlertDays: number (>= 1)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Un usuario autenticado solo puede leer su propio perfil
      allow read: if isOwner(userId);

      // Creación permitida solo por el propio usuario autenticado,
      // forzando siempre el rol BODEGA y status Activo (prevención de escalamiento de privilegios)
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.role == 'BODEGA'
        && request.resource.data.status == 'Activo';

      // Actualización permitida solo por el propio usuario autenticado,
      // garantizando la inmutabilidad de uid, role y status desde el cliente
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;

      // Eliminación prohibida desde el frontend
      allow delete: if false;
    }

    match /products/{productId} {
      // Lectura permitida a usuarios autenticados
      allow read: if isAuthenticated();

      // Creación permitida a usuarios autenticados con validaciones de campos requeridos
      allow create: if isAuthenticated()
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 2
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.category is string
        && request.resource.data.presentation is string
        && request.resource.data.minStock is int
        && request.resource.data.minStock >= 0
        && request.resource.data.status in ['Activo', 'Inactivo']
        && request.resource.data.currentStock == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      // Actualización permitida garantizando inmutabilidad de createdAt, createdBy y currentStock
      allow update: if isAuthenticated()
        && request.resource.data.code is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.minStock is int
        && request.resource.data.minStock >= 0
        && request.resource.data.status in ['Activo', 'Inactivo']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.currentStock == resource.data.currentStock
        && request.resource.data.updatedBy == request.auth.uid;

      // Prohibido eliminar productos físicamente para preservar integridad referencial e histórica
      allow delete: if false;
    }

    match /batches/{batchId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    match /entries/{entryId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /exits/{exitId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /movements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
