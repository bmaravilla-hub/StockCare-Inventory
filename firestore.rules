rules_version = '2';

// ===============================================================
// Assumed Data Model & Collections
// ===============================================================
//
// Collection: users
// Document ID: {userId} (Firebase Auth UID)
// Fields:
//   - uid: string (required, immutable)
//   - email: string (required)
//   - fullName: string (required)
//   - role: string (required, 'ADMIN' | 'BODEGA')
//   - status: string (required, 'Activo' | 'Inactivo')
//   - branch: string (optional)
//   - createdAt: string / timestamp
//
// Collection: products
// Document ID: {productId}
// Fields:
//   - code: string (required, unique identifier)
//   - name: string (required)
//   - category: string (required)
//   - presentation: string (required)
//   - minStock: number (required, >= 0)
//   - currentStock: number (required, >= 0)
//   - status: string (required, 'Activo' | 'Inactivo')
//   - description: string (optional)
//   - createdAt: string / timestamp
//   - updatedAt: string / timestamp
//   - createdBy: string (required, UID)
//   - updatedBy: string (required, UID)
//
// Collection: suppliers
// Document ID: {supplierId}
// Fields:
//   - name: string (required, size >= 3)
//   - nit: string (optional)
//   - nrc: string (optional)
//   - phone: string (optional)
//   - email: string (optional)
//   - contactName: string (optional)
//   - status: string (required, 'Activo' | 'Inactivo')
//   - createdAt: timestamp / string
//   - updatedAt: timestamp / string
//   - createdBy: string (required, UID)
//   - updatedBy: string (required, UID)
//
// Collection: entryKeys
// Document ID: {reservationKey} = {supplierId}__{normalizedDocumentNumber}
// Fields:
//   - entryId: string (required)
//   - supplierId: string (required)
//   - documentNumber: string (required)
//   - createdAt: timestamp / string
//   - createdBy: string (required, UID)
//
// Collection: batches
// Document ID: {batchId} = batch_{productId}__{normalizedBatchNumber}__{expiryDate}
// Fields:
//   - productId: string (required)
//   - batchNumber: string (required)
//   - quantity: number (required, >= 0)
//   - initialQuantity: number (required, >= 0)
//   - expiryDate: string (required, YYYY-MM-DD)
//   - supplierId: string (optional)
//   - entryId: string (required)
//   - status: string (required, 'Activo' | 'Agotado')
//   - createdAt: string / timestamp
//   - updatedAt: string / timestamp
//   - createdBy: string (required, UID)
//
// Collection: entries
// Document ID: {entryId}
// Fields:
//   - documentNumber: string (required)
//   - supplierId: string (required)
//   - supplierName: string (required)
//   - provider: string (required)
//   - date: string (required, YYYY-MM-DD)
//   - registeredBy: string (required)
//   - registeredByUid: string (required)
//   - createdAt: string / timestamp
//   - items: list (required, size > 0)
//   - notes: string (optional)
//
// Collection: exits
// Document ID: {exitId}
// Fields:
//   - productId: string (required)
//   - batchId: string (required)
//   - batchNumber: string (required)
//   - quantity: number (required, > 0)
//   - reason: string (required)
//   - reference: string (required)
//   - date: string (required, YYYY-MM-DD)
//   - registeredBy: string (required)
//   - createdAt: string
//   - notes: string (optional)
//
// Collection: movements
// Document ID: {movementId}
// Fields:
//   - date: string (required, YYYY-MM-DD)
//   - createdAt: string / timestamp
//   - productId: string (required)
//   - batchNumber: string (required)
//   - type: string (required, 'Entrada' | 'Salida')
//   - quantity: number (required, > 0)
//   - user: string (required)
//   - userId: string (required)
//   - createdBy: string (required)
//   - reference: string (required)
//   - detail: string (required)
//   - resultingStock: number (required, >= 0)
//
// Collection: settings
// Document ID: system
// Fields:
//   - pharmacyName: string
//   - branchName: string
//   - branchAddress: string
//   - phone: string
//   - expiryAlertDays: number (>= 1)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return userDocExists() && getUserData().status == 'Activo';
    }

    function hasRole(role) {
      return isActiveUser() && getUserData().role == role;
    }

    function isBodega() {
      return hasRole('BODEGA');
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Un usuario autenticado solo puede leer su propio perfil, o un ADMIN activo puede leer cualquier perfil
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());

      // Creación permitida solo por el propio usuario autenticado,
      // forzando siempre el rol BODEGA y status Activo (prevención de escalamiento de privilegios)
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.role == 'BODEGA'
        && request.resource.data.status == 'Activo';

      // Actualización permitida solo por el propio usuario autenticado,
      // garantizando la inmutabilidad de uid, role y status desde el cliente
      allow update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status;

      // Eliminación prohibida desde el frontend
      allow delete: if false;
    }

    match /products/{productId} {
      // Lectura permitida a usuarios autenticados con perfil activo
      allow read: if isActiveUser();

      // Creación permitida únicamente a personal de BODEGA activo con saldo inicial en 0
      allow create: if isBodega()
        && request.resource.data.code is string
        && request.resource.data.code.size() >= 2
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.category is string
        && request.resource.data.presentation is string
        && request.resource.data.minStock is int
        && request.resource.data.minStock >= 0
        && request.resource.data.status in ['Activo', 'Inactivo']
        && request.resource.data.currentStock == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      // Actualización permitida únicamente a personal de BODEGA activo.
      // Se contemplan dos casos estrictos:
      // Caso 1: Edición de catálogo -> currentStock es estrictamente inmutable.
      // Caso 2: Operación de inventario -> metadatos de catálogo inmutables; solo varía currentStock (entero >= 0) y auditoría.
      allow update: if isBodega() && (
        // Caso 1: Actualización de datos de catálogo (stock congelado)
        (
          request.resource.data.code is string
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 3
          && request.resource.data.minStock is int
          && request.resource.data.minStock >= 0
          && request.resource.data.status in ['Activo', 'Inactivo']
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.currentStock == resource.data.currentStock
          && request.resource.data.updatedBy == request.auth.uid
        )
        ||
        // Caso 2: Actualización de existencias por operación de inventario (metadatos congelados)
        (
          request.resource.data.code == resource.data.code
          && request.resource.data.name == resource.data.name
          && request.resource.data.category == resource.data.category
          && request.resource.data.presentation == resource.data.presentation
          && request.resource.data.minStock == resource.data.minStock
          && request.resource.data.status == resource.data.status
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.currentStock is int
          && request.resource.data.currentStock >= 0
          && request.resource.data.updatedBy == request.auth.uid
        )
      );

      // Prohibido eliminar productos físicamente para preservar integridad referencial e histórica
      allow delete: if false;
    }

    match /suppliers/{supplierId} {
      // Lectura permitida a usuarios autenticados con perfil activo
      allow read: if isActiveUser();

      // Creación permitida a BODEGA activo con validaciones de campos requeridos
      allow create: if isBodega()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.status in ['Activo', 'Inactivo']
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid;

      // Actualización permitida a BODEGA activo garantizando inmutabilidad de createdAt y createdBy
      allow update: if isBodega()
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3
        && request.resource.data.status in ['Activo', 'Inactivo']
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid;

      // Prohibido eliminar proveedores físicamente para preservar integridad referencial e histórica
      allow delete: if false;
    }

    match /entryKeys/{key} {
      // Clave determinística de reserva para prevención atómica de duplicados de factura por proveedor
      allow read: if isActiveUser();
      allow create: if isBodega()
        && request.resource.data.entryId is string
        && request.resource.data.supplierId is string
        && request.resource.data.documentNumber is string
        && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if false;
    }

    match /entries/{entryId} {
      // Lectura permitida a usuarios autenticados con perfil activo
      allow read: if isActiveUser();

      // Creación permitida a BODEGA activo con documento, proveedor, auditoría e ítems
      allow create: if isBodega()
        && request.resource.data.documentNumber is string
        && request.resource.data.supplierId is string
        && request.resource.data.supplierName is string
        && request.resource.data.registeredByUid == request.auth.uid
        && request.resource.data.items.size() > 0;

      // Prohibido modificar o eliminar entradas para preservar trazabilidad fiscal y contable
      allow update, delete: if false;
    }

    match /batches/{batchId} {
      // Lectura permitida a usuarios autenticados con perfil activo
      allow read: if isActiveUser();

      // Creación permitida a BODEGA activo con campos requeridos y coherencia de cantidades
      allow create: if isBodega()
        && request.resource.data.productId is string
        && request.resource.data.entryId is string
        && request.resource.data.batchNumber is string
        && request.resource.data.expiryDate is string
        && request.resource.data.initialQuantity is int
        && request.resource.data.initialQuantity > 0
        && request.resource.data.quantity is int
        && request.resource.data.quantity == request.resource.data.initialQuantity
        && request.resource.data.status in ['Activo', 'Agotado']
        && request.resource.data.createdBy == request.auth.uid;

      // Actualización atómica permitida a BODEGA activo manteniendo inmutabilidad de lote y coherencia
      allow update: if isBodega()
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.batchNumber == resource.data.batchNumber
        && request.resource.data.expiryDate == resource.data.expiryDate
        && request.resource.data.initialQuantity is int
        && request.resource.data.initialQuantity >= resource.data.initialQuantity
        && request.resource.data.quantity is int
        && request.resource.data.quantity >= 0
        && request.resource.data.quantity <= request.resource.data.initialQuantity;

      // Prohibido eliminar lotes físicamente
      allow delete: if false;
    }

    match /exits/{exitId} {
      allow read: if isActiveUser();
      allow create: if isBodega();
      allow update, delete: if false;
    }

    match /movements/{movementId} {
      // Movimientos de auditoría Kardex append-only
      allow read: if isActiveUser();
      allow create: if isBodega()
        && (request.resource.data.createdBy == request.auth.uid || request.resource.data.userId == request.auth.uid)
        && request.resource.data.type in ['Entrada', 'Salida']
        && request.resource.data.productId is string
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.resultingStock is int
        && request.resource.data.resultingStock >= 0;
      allow update, delete: if false;
    }

    match /settings/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
  }
}
